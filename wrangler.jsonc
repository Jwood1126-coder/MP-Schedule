{
  // Cloudflare Worker for the meal planner.
  // The D1 database has no database_id on purpose: the first `wrangler deploy`
  // creates it (automatic resource provisioning) and keeps it linked.
  // The Worker applies its own schema on the first API request (src/schema.js).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "meal-planner",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "meal-planner"
    }
  ],
  "observability": { "enabled": true }
  // No "vars": TEAM_DOMAIN, POLICY_AUD and ALLOWED_EMAILS are Worker secrets
  // set in the Cloudflare dashboard, so deploys never overwrite them.
}
