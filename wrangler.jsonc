{
  // Cloudflare Worker for the meal planner.
  // The D1 database was created ahead of time; its id is an identifier, not a
  // secret (using it still requires access to the Cloudflare account).
  // The Worker applies its own schema on the first API request (src/schema.js).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mp-schedule",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "meal-planner",
      "database_id": "470f7bbb-b6b4-4e4f-8d45-d8b4c9268dcc"
    }
  ],
  "observability": { "enabled": true }
  // No "vars": TEAM_DOMAIN, POLICY_AUD and ALLOWED_EMAILS are Worker secrets
  // set in the Cloudflare dashboard, so deploys never overwrite them.
}
